{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-svgr/client", "vitest"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "allowJs": true,
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "pretty": true,

    /* Misc */
    "composite": true,
    "allowSyntheticDefaultImports": true,

    /* Extra */
    "baseUrl": "./",
    "paths": {
      "@/*": ["./app/*"],
      "@__tests__/*": ["__tests__/*"],
      "@components/*": ["app/components/*"],
      "@assets/*": ["app/assets/*"],
      "@utils/*": ["app/utils/*"],
      "@services/*": ["app/services/*"]
    }
  },
  "include": [
    "app",
    "__tests__",
    "app/**/*.d.ts",
    "app/types/index.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "postcss.config.js",
    ".eslintrc.cjs",
    ".prettierrc",
    ".svgrrc.js"
  ]
}
